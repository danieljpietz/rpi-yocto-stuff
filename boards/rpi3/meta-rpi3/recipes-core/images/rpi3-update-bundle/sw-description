software =
{
	version = "0.1.0";

	hardware-compatibility: [ "1.0" ];

	/* ab-slot.sh (preinst) links /dev/rootfs-inactive to the slot we are not booted from */
	images: (
		{
			filename = "hello-hypervisor-image-raspberrypi3-64.rootfs.ext4.gz";
			device = "/dev/rootfs-inactive";
			type = "raw";
			compressed = "zlib";
			installed-directly = true;
		}
	);

	/* ab-slot.sh (postinst) points U-Boot's rootpart at the freshly written slot */
	scripts: (
		{
			filename = "ab-slot.sh";
			type = "shellscript";
		}
	);

	bootenv: (
		{ name = "bootcount"; value = "0"; },
		{ name = "upgrade_available"; value = "1"; }
	);
}
